{
  "name": "kodhe/example-app",
  "description": "Example project using the Kodhe Framework",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-mbstring": "*",
    "eftec/bladeone": "^4.19",
    "kodhe/framework": "^1.0 || ^2.0 || dev-main",
    "kodhe/database": "^1.0 || ^2.0 || dev-main",
    "kodhe/auth": "^1.0 || ^2.0 || dev-main"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../database",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../auth",
      "options": {
        "symlink": true
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "application/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  },
  "prefer-stable": true,
  "minimum-stability": "dev"
}