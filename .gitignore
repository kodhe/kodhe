# ========================
# CACHE & COMPILED FILES
# ========================
**/cache/
**/*.cache
**/*.bladec
**/*.blade.php.cache
storage/cache/
!storage/cache/.gitkeep
storage/framework/cache/
storage/framework/views/
storage/framework/sessions/

# ========================
# VENDOR & DEPENDENCIES
# ========================
/vendor/
vendor/autoload.php
/vendor/composer/
/node_modules/
/bower_components/
composer.lock
package-lock.json
yarn.lock

# ========================
# ENVIRONMENT
# ========================
.env
.env.*
!.env.example
.env.local

# ========================
# LOGS
# ========================
*.log
logs/
storage/logs/

# ========================
# SYSTEM
# ========================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ========================
# TESTING
# ========================
/coverage/
.phpunit.result.cache

# ========================
# THEME CACHE (Khusus untuk framework Anda)
# ========================
storage/cache/themes/**/*.bladec
storage/cache/themes/**/*.cache
!storage/cache/themes/.gitkeep
!storage/cache/themes/default/.gitkeep